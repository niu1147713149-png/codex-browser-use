{
  "manifest_version": 3,
  "name": "Codex Browser Use",
  "version": "0.5.1",
  "description": "让 Codex 列出、接管和操作你指定的 Chrome 标签页。",
  "minimum_chrome_version": "125",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "nativeMessaging",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Codex Browser Use",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
